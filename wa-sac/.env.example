# Copie para .env (ou passe como variáveis do contêiner). NUNCA versione o .env real.

# OBRIGATÓRIA. Segredo compartilhado com o JARVIS (cabeçalho x-api-key). Mínimo 16 caracteres.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WA_API_KEY=

# Intervalo mínimo entre envios, em ms (a fila soma até 40% de jitter aleatório). Padrão 5000.
# Não baixe de 3000: quanto mais rápido, maior o risco de banimento do número.
WA_INTERVALO_MIN_MS=5000

# Pasta das credenciais da sessão. Padrão ./auth (no Docker já é /data/auth, em volume).
WA_AUTH_DIR=./auth

# Porta e endereço de escuta. Padrão 3000 e 0.0.0.0.
PORT=3000
HOST=0.0.0.0
