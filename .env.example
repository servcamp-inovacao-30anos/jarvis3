# Variáveis do monitoramento de ponto (orientação por SMS).
# Cadastre na Vercel: Projeto → Settings → Environment Variables.
# Nenhuma delas chega ao navegador: só as funções da Vercel leem.
# Nunca coloque valores reais neste arquivo — ele é versionado.

# mock (simulação, nada sai) | textbee | vazio (envio desligado)
SMS_PROVIDER=

# TextBee — a chave é gerada no painel do TextBee
TEXTBEE_API_KEY=
# padrão: https://api.textbee.dev
TEXTBEE_BASE_URL=
# opcional: fixa o aparelho que envia (sem ele, vai o aparelho padrão da conta)
TEXTBEE_DEVICE_ID=
# opcional: fixa o chip (subscriptionId do simInfo do aparelho)
TEXTBEE_SIM_SUBSCRIPTION_ID=

# Valores iniciais, usados só se o pt_config (tela Configurar) não tiver o dado
SMS_LIMITE_DIA=
SMS_LIMITE_MES=
POINT_TOLERANCE_MINUTES=

# Aviso semanal de faltas injustificadas por e-mail (api/_faltas_email.js).
# NÃO precisa cadastrar nada: a conta que envia é cadastrada no próprio painel do aviso
# (a senha fica criptografada no banco com o AUTH_SECRET). Só preencha estas se quiser
# que a conta venha da Vercel em vez do painel. O aviso nunca usa a conta do Comercial.
FALTAS_MAIL_USER=
FALTAS_MAIL_PASS=
# opcionais, junto com as duas acima (padrão: email-ssl.com.br, porta 465)
FALTAS_MAIL_HOST=
FALTAS_MAIL_PORT=
# Opcional. Com ela, o agendamento (segundas 14h, 16h e 18h, vercel.json) só aceita
# quem tem a senha; a Vercel manda sozinha em cada disparo. Sem ela, o aviso roda do
# mesmo jeito: só na segunda a partir das 14h e cada área uma vez por semana.
CRON_SECRET=
