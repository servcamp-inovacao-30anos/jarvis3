# Variáveis do monitoramento de ponto (orientação por SMS).
# Cadastre na Vercel: Projeto → Settings → Environment Variables.
# Nenhuma delas chega ao navegador: só as funções da Vercel leem.
# Nunca coloque valores reais neste arquivo — ele é versionado.

# mock (simulação, nada sai) | textbee | vazio (envio desligado)
SMS_PROVIDER=

# TextBee — a chave é gerada no painel do TextBee
TEXTBEE_API_KEY=
# padrão: https://api.textbee.dev
TEXTBEE_BASE_URL=
# opcional: fixa o aparelho que envia (sem ele, vai o aparelho padrão da conta)
TEXTBEE_DEVICE_ID=
# opcional: fixa o chip (subscriptionId do simInfo do aparelho)
TEXTBEE_SIM_SUBSCRIPTION_ID=

# Valores iniciais, usados só se o pt_config (tela Configurar) não tiver o dado
SMS_LIMITE_DIA=
SMS_LIMITE_MES=
POINT_TOLERANCE_MINUTES=
