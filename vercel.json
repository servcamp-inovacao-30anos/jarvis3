{
  "crons": [
    { "path": "/api/comercial-cron?respostas=1", "schedule": "0 11 * * *" },
    { "path": "/api/comercial-cron", "schedule": "0 12 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=06", "schedule": "0 9 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=07", "schedule": "0 10 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=08", "schedule": "0 11 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=09", "schedule": "0 12 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=10", "schedule": "0 13 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=11", "schedule": "0 14 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=12", "schedule": "0 15 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=13", "schedule": "0 16 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=14", "schedule": "0 17 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=15", "schedule": "0 18 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=16", "schedule": "0 19 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=17", "schedule": "0 20 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=18", "schedule": "0 21 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=19", "schedule": "0 22 * * *" },
    { "path": "/api/rh?modulo=faltasemail&t=cron&h=20", "schedule": "0 23 * * *" }
  ],
  "functions": {
    "api/rh.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://cdnjs.cloudflare.com; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ]
}